# ── Supabase (same project as the app; this site only writes to waitlist_signups) ──
# Public project URL (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Secret / service-role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
# Accepts the new secret key (sb_secret_…) or the legacy service_role key.
SUPABASE_SECRET_KEY=

# ── Cloudflare Turnstile (domain-scoped to kagelin.app) ──
# Public site key rendered in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key used server-side for the siteverify call.
TURNSTILE_SECRET_KEY=

# ── Founding-tester waitlist cap ──
# Once waitlist_signups reaches this count, the API returns a "closed" state and
# the form shows the general-launch fallback. Change without a code deploy.
WAITLIST_FOUNDING_CAP=25

# ── Links (used in footer/CTAs) ──
NEXT_PUBLIC_APP_URL=https://app.kagelin.app
NEXT_PUBLIC_GITHUB_URL=https://github.com/Achyuth072/kagelin
